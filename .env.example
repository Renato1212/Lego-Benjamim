# ============================================================
# Aloja — Variáveis de Ambiente (copiar para .env.local ou configurar no Vercel)
# ============================================================

# Base de dados PostgreSQL (Neon, Supabase, Railway, etc.)
# Exemplo Neon: postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/aloja?sslmode=require
DATABASE_URL=

# Auth.js — segredo para encriptar as sessões (gere um com: openssl rand -hex 32)
AUTH_SECRET=

# URL pública da aplicação (sem barra final)
NEXT_PUBLIC_APP_URL=https://aloja.pt

# SIBA/AIMA — 'test' usa homologação (siba.sef.pt/bawsdev), 'production' usa produção
# Mantenha 'test' até confirmar que a integração funciona com as suas credenciais reais
SIBA_ENV=test

# Anthropic (usado apenas no /demo para o assistente de IA — pode deixar vazio)
ANTHROPIC_API_KEY=
