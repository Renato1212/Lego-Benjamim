// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== USER & AUTH =====================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  avatar    String   @default("🧱")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile
  profile    UserProfile?
  children   ChildProfile[]
  parentFor  ChildProfile[] @relation("ParentChild")

  @@map("users")
}

model UserProfile {
  id          String @id @default(cuid())
  userId      String @unique
  level       Int    @default(1)
  levelName   String @default("Brick Beginner")
  xp          Int    @default(0)
  xpToNext    Int    @default(500)
  streakDays  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ChildProfile {
  id        String   @id @default(cuid())
  userId    String
  parentId  String
  name      String
  avatar    String   @default("🧱")
  ageGroup  String   @default("6-8")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent User @relation("ParentChild", fields: [parentId], references: [id])

  // Settings
  settings ChildSettings?

  @@map("child_profiles")
}

model ChildSettings {
  id                String  @id @default(cuid())
  childProfileId    String  @unique
  storyModeEnabled  Boolean @default(true)
  buddyChatEnabled  Boolean @default(true)
  sharingEnabled    Boolean @default(false)
  ideasEnabled      Boolean @default(true)
  dailyTimeLimitMin Int     @default(60)
  parentPin         String  @default("1234")

  childProfile ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@map("child_settings")
}

// ===================== BRICK INVENTORY =====================

model BrickInventory {
  id        String   @id @default(cuid())
  userId    String
  partNum   String
  colorId   Int
  colorName String
  colorRgb  String
  quantity  Int      @default(0)
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, partNum, colorId])
  @@index([userId])
  @@map("brick_inventory")
}

model OwnedSet {
  id        String   @id @default(cuid())
  userId    String
  setNum    String
  name      String
  year      Int
  theme     String
  numParts  Int
  imageUrl  String   @default("")
  addedAt   DateTime @default(now())

  @@unique([userId, setNum])
  @@index([userId])
  @@map("owned_sets")
}

// ===================== CREATIONS =====================

model Creation {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  bricksUsed  Int      @default(0)
  story       String?  @db.Text
  isPublic    Boolean  @default(false)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags     CreationTag[]
  comments CreationComment[]

  @@index([userId])
  @@map("creations")
}

model CreationTag {
  id         String   @id @default(cuid())
  creationId String
  tag        String
  createdAt  DateTime @default(now())

  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@index([creationId])
  @@index([tag])
  @@map("creation_tags")
}

model CreationComment {
  id         String   @id @default(cuid())
  creationId String
  userId     String
  content    String   @db.Text
  isAI       Boolean  @default(false)
  createdAt  DateTime @default(now())

  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@index([creationId])
  @@map("creation_comments")
}

// ===================== QUESTS & GAMIFICATION =====================

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String
  xpReward    Int
  icon        String   @default("🎯")
  type        String   @default("daily")  // daily | weekly | achievement
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())

  userQuests UserQuest[]

  @@map("quests")
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  questId     String
  progress    Int      @default(0)
  total       Int      @default(1)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  startedAt   DateTime @default(now())

  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
  @@index([userId])
  @@map("user_quests")
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String
  color       String @default("#FFCC00")
  xpReward    Int    @default(0)
  rarity      String @default("common")  // common | rare | epic | legendary

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ===================== BUILD IDEAS =====================

model BuildIdea {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  difficulty      String   // easy | medium | hard
  theme           String
  estimatedParts  Int
  imageUrl        String?
  isAIGenerated   Boolean  @default(false)
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags BuildIdeaTag[]

  @@index([theme])
  @@index([difficulty])
  @@map("build_ideas")
}

model BuildIdeaTag {
  id        String @id @default(cuid())
  ideaId    String
  tag       String

  idea BuildIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([tag])
  @@map("build_idea_tags")
}

// ===================== ACTIVITY LOG =====================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // login | create | quest_complete | badge_earn | etc
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
